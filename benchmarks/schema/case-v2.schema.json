{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cartertinney/mqtt-spec-mcp/benchmarks/schema/case-v2.schema.json",
  "title": "MQTT specification benchmark case, corpus format 2",
  "description": "One line of dev.jsonl or test.jsonl. Answers are judged against plain-language facts; every fact and forbidden claim carries a verbatim quote from the OASIS source text. Only id, version, prompt and word_limit are shown to the agents being evaluated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "kind",
    "topic",
    "origin",
    "prompt",
    "word_limit",
    "sections_needed",
    "facts",
    "forbidden",
    "reference_answer",
    "split"
  ],
  "properties": {
    "id": {
      "description": "Unique across dev.jsonl and test.jsonl.",
      "$ref": "#/$defs/slug"
    },
    "version": {
      "description": "The MQTT version the question is about; 'both' for questions comparing the two.",
      "enum": ["3.1.1", "5.0", "both"]
    },
    "kind": {
      "enum": ["scenario", "synthesis", "edge", "rule", "lookup", "silent"]
    },
    "topic": {
      "description": "The case's main topic area, for coverage planning and analysis.",
      "enum": [
        "connection",
        "session",
        "keep-alive",
        "qos-flows",
        "retransmission-ordering",
        "retained",
        "will",
        "subscriptions",
        "topics",
        "flow-control",
        "properties-reason-codes",
        "return-codes",
        "authentication",
        "errors",
        "data-representation",
        "security-transport",
        "conformance"
      ]
    },
    "origin": {
      "description": "'spec': written from the specification text. 'real-world': inspired by a public report of a problem, question or disagreement (paraphrased, details changed).",
      "enum": ["spec", "real-world"]
    },
    "inspired_by": {
      "description": "URLs of the public material a real-world case was inspired by. Never shown to the agents being evaluated.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri", "pattern": "^https?://"}
    },
    "clarification_refs": {
      "description": "Optional IDs in clarifications.json. Informative OASIS issue context, not normative answer-key evidence and not shown to answerers.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^MQTT-[0-9]+$"}
    },
    "prompt": {
      "description": "The question, as an engineer would ask it. No section numbers or requirement labels.",
      "type": "string",
      "minLength": 20,
      "maxLength": 1500
    },
    "word_limit": {
      "description": "Maximum answer length in words; fits a complete answer.",
      "type": "integer",
      "minimum": 120,
      "maximum": 300
    },
    "sections_needed": {
      "description": "Sections a complete answer draws on. In comparison cases ('both') each entry is version-qualified, e.g. '3.1.1:3.1.2.4' or '5.0:3.1.2.11.2'.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sectionRef"}
    },
    "facts": {
      "description": "What a complete, correct answer must contain. 3-8 facts (2-4 for lookups); at least one essential.",
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/fact"},
      "contains": {"type": "object", "properties": {"essential": {"const": true}}, "required": ["essential"]}
    },
    "forbidden": {
      "description": "0-3 specific wrong claims a plausible answer might make.",
      "type": "array",
      "maxItems": 3,
      "items": {"$ref": "#/$defs/forbidden"}
    },
    "reference_answer": {
      "description": "A complete answer within word_limit that states every fact and cites its sections.",
      "type": "string",
      "minLength": 50
    },
    "split": {"enum": ["dev", "test"]}
  },
  "allOf": [
    {
      "if": {"properties": {"version": {"const": "both"}}, "required": ["version"]},
      "then": {
        "properties": {
          "sections_needed": {"items": {"pattern": "^(3\\.1\\.1|5\\.0):[0-9]+(\\.[0-9]+)*$"}}
        }
      },
      "else": {
        "properties": {"sections_needed": {"items": {"pattern": "^[0-9]+(\\.[0-9]+)*$"}}}
      }
    },
    {
      "if": {"properties": {"version": {"const": "5.0"}}, "required": ["version"]},
      "then": {
        "properties": {
          "facts": {"items": {"properties": {"version": {"const": "5.0"}}}},
          "forbidden": {"items": {"properties": {"version": {"const": "5.0"}}}}
        }
      }
    },
    {
      "if": {"properties": {"version": {"const": "3.1.1"}}, "required": ["version"]},
      "then": {
        "properties": {
          "facts": {"items": {"properties": {"version": {"const": "3.1.1"}}}},
          "forbidden": {"items": {"properties": {"version": {"const": "3.1.1"}}}}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "lookup"}}, "required": ["kind"]},
      "then": {"properties": {"facts": {"maxItems": 4}}},
      "else": {"properties": {"facts": {"minItems": 3}}}
    },
    {
      "if": {"properties": {"kind": {"const": "silent"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "facts": {
            "contains": {"type": "object", "properties": {"absence": {"const": true}}, "required": ["absence"]}
          }
        }
      },
      "else": {
        "properties": {"facts": {"items": {"not": {"required": ["absence"]}}}}
      }
    },
    {
      "if": {"properties": {"origin": {"const": "real-world"}}, "required": ["origin"]},
      "then": {"required": ["inspired_by"]},
      "else": {"not": {"required": ["inspired_by"]}}
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "sectionId": {
      "description": "A numbered section of the fact's version, e.g. '3.1.2.4'.",
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)*$"
    },
    "sectionRef": {
      "type": "string",
      "pattern": "^((3\\.1\\.1|5\\.0):)?[0-9]+(\\.[0-9]+)*$"
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "version", "essential", "sections", "quote"],
      "properties": {
        "id": {"description": "Unique within the case.", "$ref": "#/$defs/slug"},
        "statement": {
          "description": "One atomic fact in plain language, keeping the spec's MUST/SHOULD/MAY and conditions.",
          "type": "string",
          "minLength": 10
        },
        "version": {"enum": ["3.1.1", "5.0"]},
        "essential": {
          "description": "true if a correct answer cannot omit this fact.",
          "type": "boolean"
        },
        "sections": {
          "description": "Every section of this version that states the fact.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sectionId"}
        },
        "quote": {
          "description": "Verbatim supporting text from the source (whitespace may be normalized).",
          "type": "string",
          "minLength": 10
        },
        "absence": {
          "description": "Silent cases only: the fact states what the specification does not define, and the quote is the closest related text.",
          "const": true
        }
      }
    },
    "forbidden": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "why_wrong", "version", "sections", "quote"],
      "properties": {
        "id": {"description": "Unique within the case.", "$ref": "#/$defs/slug"},
        "claim": {"description": "The wrong statement, as an answer might make it.", "type": "string", "minLength": 10},
        "why_wrong": {"type": "string", "minLength": 10},
        "version": {"description": "The version the claim is wrong about.", "enum": ["3.1.1", "5.0"]},
        "sections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sectionId"}
        },
        "quote": {
          "description": "Verbatim source text showing the claim is wrong.",
          "type": "string",
          "minLength": 10
        }
      }
    }
  }
}
