{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cartertinney/mqtt-spec-mcp/benchmarks/schema/manifest-v2.schema.json",
  "title": "MQTT specification benchmark corpus manifest, corpus format 2",
  "description": "manifest.json at the corpus root: pinned sources, split seed, and case-file hashes. Draft manifests are refreshed during authoring. Frozen case files must not change; corrections require a new corpus_version and changelog entry. Legacy manifests without status are frozen.",
  "type": "object",
  "additionalProperties": false,
  "required": ["corpus_format", "corpus_version", "created", "split_seed", "sources", "files"],
  "properties": {
    "corpus_format": {"const": 2},
    "corpus_version": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$"},
    "status": {
      "description": "Draft permits reviewed regeneration without freezing. Frozen, including a legacy manifest with no status, prohibits overwrites.",
      "enum": ["draft", "frozen"]
    },
    "created": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "split_seed": {"type": "integer"},
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["3.1.1", "5.0"],
      "properties": {
        "3.1.1": {"$ref": "#/$defs/source"},
        "5.0": {"$ref": "#/$defs/source"}
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dev.jsonl", "test.jsonl"],
      "properties": {
        "dev.jsonl": {"$ref": "#/$defs/file"},
        "test.jsonl": {"$ref": "#/$defs/file"}
      }
    },
    "changelog": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "html_sha256", "text_file", "text_sha256"],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https://docs\\.oasis-open\\.org/"},
        "html_sha256": {"$ref": "#/$defs/sha256"},
        "text_file": {"type": "string", "pattern": "^sources/"},
        "text_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "cases"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "cases": {"type": "integer", "minimum": 1}
      }
    }
  }
}
